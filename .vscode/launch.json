{
  // Debugging kaas-ui. Needs `vadimcn.vscode-lldb` (CodeLLDB), which ships its
  // own lldb — there is no system one in this container.
  //
  // Only the Rust half is debugged here. A breakpoint in a .tsx file means
  // nothing to this process — use the browser's devtools against the Vite
  // server, which proxies /api and /health back to the binary on 8099.
  //
  // **Which URL you open decides which server hands you the frontend**, and
  // that is the thing worth getting straight:
  //
  //   /absproxy/5173/  → Vite. Hot reload. API proxied to the binary, so Rust
  //                      breakpoints still hit. This is what the one
  //                      configuration below is for.
  //   /proxy/8099/     → the binary, serving web/dist. No hot reload; edits
  //                      appear only after `npm run build`. There is no launch
  //                      configuration for it any more — run the binary from a
  //                      terminal with KAAS_UI_SERVER__BASE_PATH=/proxy/8099
  //                      if you need to check what actually ships.
  //
  // A debug build reads web/dist off disk per request — rust-embed is built
  // without `debug-embed` — so a frontend change never needs `cargo build`.
  // Only a *release* build embeds the folder at compile time.
  "version": "0.2.0",
  "configurations": [
    {
      // Starts Vite first, then the binary under the debugger, so Rust
      // breakpoints and hot reload are on at the same time. Runs against the
      // three development clusters in config.dev.yaml, one of which is
      // deliberately unreachable.
      //
      // Open **https://<host>/absproxy/5173/** — Vite's URL, not the
      // binary's. `/absproxy` and not `/proxy`: the two code-server routes
      // differ in that /proxy strips the prefix before forwarding and
      // /absproxy passes it through, and Vite needs it passed through. See
      // web/vite.config.ts.
      //
      // No `KAAS_UI_SERVER__BASE_PATH` here on purpose: the binary is not
      // serving HTML in this mode, so it has no index.html to rewrite and
      // nothing to be told about a prefix. Vite owns the base path instead.
      "type": "lldb",
      "request": "launch",
      "name": "kaas-ui + frontend hot reload (code-server)",
      "preLaunchTask": "web: vite dev server",
      // VS Code does not stop a preLaunchTask when the session ends, so Vite
      // would outlive every debug stop and keep serving /absproxy/5173/ with
      // no binary behind it. This takes it down with the session.
      "postDebugTask": "web: stop vite dev server",
      "cargo": {
        "args": ["build", "--bin=kaas-ui", "--package=kaas-ui-server"],
        "filter": { "name": "kaas-ui", "kind": "bin" }
      },
      "args": ["--config", "config.dev.yaml"],
      "cwd": "${workspaceFolder}",
      "env": {
        // `debug` is where the message stream announces itself — one line per
        // stream open, with the cluster, topic, mode and caller.
        "RUST_LOG": "info,kaas_ui=debug,kaas_ui_api=debug"
      },
      "sourceLanguages": ["rust"]
    }
  ]
}
